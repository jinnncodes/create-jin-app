{
  "name": "create-jin-app",
  "version": "0.1.0",
  "private": false,
  "description": "Reusable React + Firebase starter kit",
  "type": "module",
  "bin": {
    "create-jin-app": "./bin/create-jin-app.mjs"
  },
  "files": [
    "bin/create-jin-app.mjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinnncodes/create-jin-app.git"
  },
  "bugs": {
    "url": "https://github.com/jinnncodes/create-jin-app/issues"
  },
  "homepage": "https://github.com/jinnncodes/create-jin-app#readme",
  "license": "MIT",
  "author": "Jin",
  "scripts": {
    "ensure-firebase-config": "node ./scripts/ensure-firebase-config.mjs",
    "predev": "pnpm run ensure-firebase-config",
    "prebuild": "pnpm run ensure-firebase-config",
    "dev": "vite",
    "dev:firebase": "concurrently -k -n emulators,ui -c blue,green \"pnpm emulators\" \"pnpm ui\"",
    "ui": "vite",
    "emulators": "node scripts/start-emulators-functions.mjs",
    "seed": "node scripts/seed-emulator.mjs",
    "seed:prod": "node scripts/seed-emulator.mjs --production",
    "build": "tsc -b && vite build",
    "build:functions": "pnpm --dir cloud-functions run build",
    "lint": "eslint .",
    "typecheck": "tsc -b && pnpm --dir cloud-functions run lint",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/vite": "^4.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.8.0",
    "lucide-react": "^0.511.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.20",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^13.0.0",
    "globals": "^16.0.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  },
  "keywords": [
    "react",
    "vite",
    "firebase",
    "firestore",
    "cloud-functions",
    "tailwind",
    "shadcn",
    "starter"
  ]
}
