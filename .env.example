# Frontend (Vite)
VITE_APP_NAME=Jin App
VITE_APP_URL=http://localhost:5173
VITE_AUTH_MODE=local
VITE_ALLOW_ANONYMOUS_USERS=false

# Set to firebase when you are ready for Auth + Firestore
# VITE_AUTH_MODE=firebase

# Firebase emulators (only used when VITE_AUTH_MODE=firebase)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_STORAGE_EMULATOR_PORT=9199
VITE_FUNCTIONS_EMULATOR_PORT=5001

# Production Cloud Functions origin (HTTPS functions, not callables)
# VITE_FUNCTIONS_URL=https://us-central1-your-project.cloudfunctions.net

# Production seed opt-in. Leave false unless you intentionally run `pnpm seed:prod`.
ALLOW_PRODUCTION_SEED=false
# FIREBASE_PROJECT_ID=your-production-project-id
